{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "types": ["node"],
    "jsx": "preserve"
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "packages/*/*.ts",
    "apps/*/src",
    "apps/*/test",
    "apps/*/*.ts",
    "scripts"
  ]
}
