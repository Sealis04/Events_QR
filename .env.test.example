# Settings for the TEST copy (docker/compose.test.yml, docs/test-setup.md). Copy to .env.test and
# fill in the blanks with NEW values: never reuse a production secret here, or test tickets would
# work at real gates. Never commit .env.test.

# The database of the test copy. Its name must contain "test" (scripts/test-reset.ts checks).
DB_NAME=events_qr_test
DB_USER=events_qr_test
DB_PASSWORD=
DB_ROOT_PASSWORD=

# `openssl rand -hex 32` for each, different from production.
SESSION_SECRET=
EVENT_KEY_MASTER=
# Passphrase for the test copy's own signing key in .secrets-test/ (scripts/gen-signing-key.ts).
SIGNING_KEY_PASSPHRASE=

# Shown as a red banner on every page and put in front of ticket email subjects.
INSTANCE_LABEL=TEST

# This copy's address, and production's, so the reset and seed scripts can tell them apart.
PUBLIC_URL=https://test.example.org
PRODUCTION_URL=https://tickets.example.org
# The test hub, if you use one (spare hub or a laptop running docker/compose.hub.yml).
# HUB_URL=https://hub-test.example.org

# Sender shown on the test emails (they only ever reach Mailpit).
MAIL_FROM=tickets-test@example.org

EVENT_TIMEZONE=UTC

# Host ports (loopback): the app for Nginx Proxy Manager, and Mailpit's web inbox.
# APP_PORT=3002
# MAILPIT_PORT=8025

# Optional: PINs for the accounts scripts/test-reset.ts creates (defaults in that script).
# TEST_ADMIN_PIN=20262026
# TEST_SUPERVISOR_PIN=30303030
# TEST_STAFF_PIN=404040
