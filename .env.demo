# Placeholder settings for local development. Copy to .env (scripts/ccr-session-init.sh does this
# and fills in the blank secrets below). Never commit a real .env.
APP_MODE=server

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=events_qr
DB_USER=events_qr
DB_PASSWORD=change-me
# Only used by the MariaDB container on first start (docker/compose.vm.yml).
DB_ROOT_PASSWORD=change-me-root

# Session cookie HMAC key (32+ random characters). `openssl rand -hex 32`
SESSION_SECRET=
# Plain-http development only; leave unset in production (cookies are Secure by default there).
COOKIE_SECURE=false

# Encrypts each event's AES key in the database: 32 bytes as 64 hex characters. `openssl rand -hex 32`
EVENT_KEY_MASTER=
# Ed25519 signing key file (created by scripts/gen-signing-key.ts) and its passphrase.
SIGNING_KEY_PATH=.secrets/signing-key.json
SIGNING_KEY_PASSPHRASE=

# VM: the address printed into DEV1: setup QRs for phones to ask first (the venue hub). Without it the QR
# carries the address of the server that made it.
# HUB_URL=https://hub.example.org
# VM: this server's own public address, handed to phones and hubs as the fallback "cloud" address
# (defaults to the address the request came in on).
# PUBLIC_URL=https://tickets.example.org
# IANA zone for "00:00 local on the first day" (slot minutes) unless an event sets its own.
EVENT_TIMEZONE=UTC

# Worker (APP_MODE=worker): Gmail API through a Workspace service account with domain-wide delegation.
# GMAIL_SA_KEY_PATH=.secrets/gmail-sa.json
# GMAIL_SENDER=tickets@example.org
# EMAIL_DAILY_LIMIT=1800

# Retention job (worker, nightly): names and emails are cleared RETENTION_PII_DAYS after an event ends,
# its scans are deleted after RETENTION_SCANS_DAYS. RETENTION_DRY_RUN=true only logs the counts.
# RETENTION_PII_DAYS=365
# RETENTION_SCANS_DAYS=1095
# RETENTION_DRY_RUN=false
# RETENTION_HOUR_UTC=2

# Venue hub (APP_MODE=hub, docker/compose.hub.yml): none of the secrets above are used or wanted there.
# HUB_DB_PATH=data/hub.sqlite
# HUB_TICKET_PULL_SECONDS=30
# HUB_SCAN_PUSH_SECONDS=5
# HUB_MAX_BACKOFF_SECONDS=60
# HUB_VM_TIMEOUT_SECONDS=10
